# GEMINI_API_KEY: Required for Gemini AI API calls (garment splitting & hanging generation).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION:
# Configure these in the hosting provider (Vercel Project Settings > Environment Variables).
# They are deployment-level settings shared by every browser/device, not local dashboard inputs.
# SUPABASE_* is used by the runtime /api/config endpoint; VITE_* is also supported for static builds.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ADMIN AUTHENTICATION:
# Set your secure admin password for owner dashboard verification.
VITE_ADMIN_PASSWORD="your-secure-admin-password"
