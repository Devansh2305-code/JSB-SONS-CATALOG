# GEMINI_API_KEY: Required for Gemini AI API calls (garment splitting & hanging generation).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and public Anon key for database & storage sync.
# All users and customer devices automatically connect to this shared database.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ADMIN AUTHENTICATION:
# Set your secure admin password for owner dashboard verification.
VITE_ADMIN_PASSWORD="your-secure-admin-password"
